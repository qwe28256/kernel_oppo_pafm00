&tlmm {
	/delete-node/ pcie1;
	/delete-node/ qupv3_se2_i2c_pins;
	/delete-node/ qupv3_se2_spi_pins;
	/delete-node/ cam_sensor_rear_vana;
	/delete-node/ sec_aux_pcm_din;
	/delete-node/ sec_mi2s_sd0;
	/delete-node/ qupv3_se15_i2c_pins;
	/delete-node/ qupv3_se15_spi_pins;

	cam_res_mgr_active: cam_res_mgr_active {
		mux {
			pins = "gpio122";
		};

		config {
			pins = "gpio122";
		};
	};

	cam_sensor_rear_vana: cam_sensor_rear_vana {
		/* AVDD LDO */
		mux {
			pins = "gpio27";
			function = "gpio";
		};

		config {
			pins = "gpio27";
			bias-disable; /* No PULL */
			drive-strength = <2>; /* 2 MA */
		};
	};

	cam_res_mgr_suspend: cam_res_mgr_suspend {
		mux {
			pins = "gpio122","gpio8";
		};

		config {
			pins = "gpio122";
		};
	};

	cam_sensor_rear_active: cam_sensor_rear_active {
		mux {
			pins = "gpio28";
			function = "gpio";
		};

		config {
			pins = "gpio28";
			bias-disable; /* No PULL */
			drive-strength = <2>; /* 2 MA */
		};
	};

	cam_sensor_rear_suspend: cam_sensor_rear_suspend {
		mux {
			pins = "gpio28";
			function = "gpio";
		};

		config {
			pins = "gpio28";
			bias-pull-down; /* PULL DOWN */
			drive-strength = <2>; /* 2 MA */
			output-low;
		};
	};

	cam_sensor_front_active: cam_sensor_front_active {
		mux {
			pins = "gpio9","gpio117";
			function = "gpio";
		};

		config {
			pins = "gpio9","gpio117";
			bias-disable; /* No PULL */
			drive-strength = <2>; /* 2 MA */
		};
	};

	cam_sensor_front_suspend: cam_sensor_front_suspend {
		mux {
			pins = "gpio9","gpio117";
			function = "gpio";
		};

		config {
			pins = "gpio9","gpio117";
			bias-pull-down; /* PULL DOWN */
			drive-strength = <2>; /* 2 MA */
			output-low;
		};
	};

	cam_sensor_rear2_active: cam_sensor_rear2_active {
		mux {
			pins = "gpio23","gpio82","gpio79";
			function = "gpio";
		};

		config {
			pins = "gpio23","gpio82","gpio79";
			bias-disable; /* No PULL */
			drive-strength = <2>; /* 2 MA */
		};
	};

	cam_sensor_rear2_suspend: cam_sensor_rear2_suspend {
		mux {
			pins = "gpio23","gpio82","gpio79";
			function = "gpio";
		};
		config {
			pins = "gpio23","gpio82","gpio79";
			bias-pull-down; /* PULL DOWN */
			drive-strength = <2>; /* 2 MA */
			output-low;
		};
	};
};

/* Regulator */
&pm8998_l28 {
	regulator-max-microvolt = <3300000>;
};

&pmi8998_bob {
	regulator-max-microvolt = <3900000>;
};

&pmi8998_bob_ao {
	regulator-max-microvolt = <3900000>;
};

/*
 * OPLUS port note: the OPPO additions below originally lived in
 * sdm845-mtp.dtsi (import commit 6e9980f6fec8), which broke standalone
 * sdm845-mtp.dtb builds (key_vol_down_default / hw_version_* labels only
 * exist in this file). Moved here; DT node-merge semantics override the
 * generic mtp gpio_keys for Find X (17107/17127) only.
 */
&soc {
        gpio_keys {
                pinctrl-names = "default";
                pinctrl-0 = <&key_vol_up_default
                             &key_vol_down_default>;

                /delete-node/ cam_snapshot;
                /delete-node/ cam_focus;

                vol_down {
                        label = "volume_down";
                        gpios = <&pm8998_gpios 5 GPIO_ACTIVE_LOW>;
                        linux,input-type = <1>;
                        linux,code = <114>;
                        gpio-key,wakeup;
                        debounce-interval = <15>;
                        linux,can-disable;
                };

                devinfo {
                        compatible = "oppo-devinfo";
                        Hw,sub_hwid_1 = <&tlmm 24 0x00>;
                        Hw,high_version = <&tlmm 116 0x00>;
                        pinctrl-names = "default","hw_sub_gpio_sleep", "high_version_active", "high_version_sleep";
                        pinctrl-0 = <&hw_sub_gpio_active>;
                        pinctrl-1 = <&hw_sub_gpio_sleep>;
                        pinctrl-2 = <&hw_version_active>;
                        pinctrl-3 = <&hw_version_sleep>;
                };
        };
};
