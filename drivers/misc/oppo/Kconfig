menuconfig OPPO_MOTOR
	bool "OPPO motor control system"
	depends on I2C
	select REGMAP_I2C
	help
	  Say Y here to enable OPPO motor control system support

if OPPO_MOTOR

config CAMERA_MOTOR_DRV8834
	tristate "CAMERA MOTOR DRV8834 Controler"
	default n
	help
	  Say Y here to enable DRV8834.

config DIGITAL_HALL_M1120
	tristate "digital hall m1120 Controler"
	default n
	help
	  Say Y here to enable m1120.

config MOTOR_CLASS_INTERFACE
	bool "OPPO motor class interface"
	help
	  Say Y here if you want to using motor class interface

endif #OPPO_CHARGER

config OPPO_SIMPLE_ROOT
	bool "OPPO simple in-kernel root (debug only)"
	default n
	help
	  Say Y here to make do_execveat_common() escalate any process that
	  executes /data/local/tmp/su to uid 0 (and switch SELinux to
	  permissive), giving the PAFM00 kernel-porting workflow a root shell
	  without re-patching every test boot image for APatch.

	  The trigger path sits in /data/local/tmp (0771 shell:shell), so only
	  adb shell or root can reach it.  Still, never enable this in a kernel
	  you intend to ship.
